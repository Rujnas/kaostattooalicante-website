# ----------------------------------------------------------------------
# Tipos MIME (Vídeo, Fuentes, Imágenes WebP y SVG)
# ----------------------------------------------------------------------
<IfModule mod_mime.c>
    AddType video/webm .webm
    AddType video/mp4 .mp4
    AddType image/webp .webp
    AddType image/svg+xml .svg .svgz
    AddType font/woff2 .woff2
    AddType font/woff .woff
    AddType font/ttf .ttf
    AddType font/otf .otf
</IfModule>

# ----------------------------------------------------------------------
# Compresión Gzip / Deflate (HTML, CSS, JS, JSON, SVG, Fuentes)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json
    AddOutputFilterByType DEFLATE application/xml application/xhtml+xml application/rss+xml
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2 application/font-woff application/font-woff2
</IfModule>

# ----------------------------------------------------------------------
# Expiración de Caché del Navegador (mod_expires: 1 año para estáticos)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML y JSON dinámico: sin caché agresiva para reflejar cambios inmediatos
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType application/json "access plus 0 seconds"

    # CSS y JavaScript (versionados con ?v=): 1 año
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Imágenes y Favicons: 1 año
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/jpg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # Fuentes web: 1 año
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # Vídeos: 1 año
    ExpiresByType video/mp4 "access plus 1 year"
    ExpiresByType video/webm "access plus 1 year"
</IfModule>

# ----------------------------------------------------------------------
# Cabeceras de Seguridad y Cache-Control
# ----------------------------------------------------------------------
<IfModule mod_headers.c>
    # Ocultar X-Powered-By
    Header unset X-Powered-By
    Header always unset X-Powered-By

    # Strict-Transport-Security (HSTS): 1 año, incluye subdominios y precarga
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" env=HTTPS

    # X-Content-Type-Options: evitar MIME-sniffing
    Header always set X-Content-Type-Options "nosniff"

    # Referrer-Policy: proteger la privacidad en referencias a terceros
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Permissions-Policy: restringir permisos innecesarios del navegador
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"

    # X-Frame-Options: protección contra clickjacking
    Header always set X-Frame-Options "SAMEORIGIN"

    # Cache-Control para activos estáticos (1 año, inmutables)
    <FilesMatch "\.(ico|jpe?g|png|gif|webp|svg|woff2?|ttf|otf|mp4|webm)$">
        Header set Cache-Control "max-age=31536000, public, immutable"
    </FilesMatch>

    # CSS y JS (versionados con ?v=): 1 año
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>
</IfModule>

# Force HTTPS and canonical domain (no www)
# Redirect kaostattoo.es (all variants) to kaostattooalicante.es
RewriteEngine On
RewriteBase /

# Redirect kaostattoo.es (with or without www, http or https) to canonical
RewriteCond %{HTTP_HOST} ^(www\.)?kaostattoo\.es$ [NC]
RewriteRule ^(.*)$ https://kaostattooalicante.es/$1 [R=301,L]

# Redirect www.kaostattooalicante.es to non-www
RewriteCond %{HTTP_HOST} ^www\.kaostattooalicante\.es$ [NC]
RewriteRule ^(.*)$ https://kaostattooalicante.es/$1 [R=301,L]

# Redirect HTTP to HTTPS (for kaostattooalicante.es)
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^kaostattooalicante\.es$ [NC]
RewriteRule ^(.*)$ https://kaostattooalicante.es/$1 [R=301,L]

# Redirect old English URLs (Spanish slugs) to the translated ones (301)
RewriteRule ^en/equipo/?$ /en/team/ [R=301,L]
RewriteRule ^en/anilladora/?$ /en/piercer/ [R=301,L]
RewriteRule ^en/estilos/?$ /en/styles/ [R=301,L]
RewriteRule ^en/tatuajes/?$ /en/tattoos/ [R=301,L]
RewriteRule ^en/dibujos-cuadros/?$ /en/art/ [R=301,L]
RewriteRule ^en/contacto/?$ /en/contact/ [R=301,L]

# Clean URL routing - serve index.php (per-page SEO) for all SPA routes
# Skip existing files and directories (images, css, js, fonts, videos, etc.)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(equipo|anilladora|estilos|tatuajes|piercings|dibujos-cuadros|contacto|blog|politica-de-privacidad|politica-de-cookies|aviso-legal)/?$ /index.php [L]

# English version: /en/ and /en/<translated-route>/
RewriteRule ^en/?$ /index.php [L]
RewriteRule ^en/(team|piercer|styles|tattoos|piercings|art|contact|blog|privacy-policy|cookie-policy|legal-notice)/?$ /index.php [L]

# Home page ("/") served through index.php too
DirectoryIndex index.php
